[Unit]
Description=Check arXiv Digest every 10 minutes during Beijing daytime

[Timer]
# 03:00 UTC = 11:00 Beijing. The script skips the 10:00/10:10/10:20 checks.
OnCalendar=*-*-* 03..15:00/10:00 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=yes
Unit=arxiv-digest-scheduler.service

[Install]
WantedBy=timers.target
