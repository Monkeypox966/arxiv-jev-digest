# Copy to .env for local use. Never commit credentials.
TYPESAFE_API_KEY=
# Only needed when [jev].backend = "openrouter"
OPENROUTER_API_KEY=
# Default key for any other System One-compatible backend.
DECISION_API_KEY=
# Set [jev].api_key_env to use another environment variable locally.
DEEPSEEK_API_KEY=

# SMTP credentials; host/port/security are in config.toml.
SMTP_USERNAME=
SMTP_PASSWORD=
# Normally the same address as SMTP_USERNAME.
EMAIL_FROM=
# Comma-separated recipients. These override [email].recipients.
EMAIL_TO=
